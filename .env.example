# Postgres (Neon / Vercel Postgres). Vercel's Neon integration sets this for you.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Claude API — the agent layer (scout, pitch, negotiator, counsel, books)
ANTHROPIC_API_KEY=""

# TikTok Display API — creator metric ingestion.
# Register an app at developers.tiktok.com, add the Login Kit and Display API
# products, and request the scopes user.info.basic, user.info.profile,
# user.info.stats and video.list. TikTok must approve the app before real
# accounts can authorize it.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://nspiire.vercel.app/api/tiktok/callback"

# Email — Iris's outreach to brands (Resend).
# Send from a SUBDOMAIN, not the root domain: cold outreach reputation must
# never touch the domain that sends invoices and login mail. Verify it in
# Resend and add the SPF/DKIM records they give you, plus a DMARC policy.
RESEND_API_KEY=""
NSPIIRE_MAIL_FROM="iris@send.nspiire.com"
# Where a brand's plain reply goes. Leave blank to reply to the From address.
NSPIIRE_MAIL_REPLY_TO=""
# Physical postal address, required in every commercial email by CAN-SPAM.
# Sending refuses without it rather than shipping a placeholder to a brand.
NSPIIRE_POSTAL_ADDRESS=""

# Public origin, used for brand deal-room links and social previews.
NEXT_PUBLIC_SITE_URL="https://nspiire.vercel.app"
