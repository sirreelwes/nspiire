// Nspiire core data model — blueprint §6
// Every state transition and interaction is logged: that log is the
// training data for the deal-terms advisor (blueprint P4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  niche         String?
  // Linked social accounts
  socials       SocialAccount[]
  // Negotiation guardrails: floor rates, deliverable limits, usage-rights
  // limits, exclusivity limits, do-not-work-with list. JSON for MVP.
  guardrails    Json     @default("{}")
  // Rate card per deliverable type
  rateCard      Json     @default("{}")
  // Voice/style samples for Pitch agent
  voiceProfile  Json     @default("{}")
  // Approval policy: which gates require human sign-off (default: all)
  approvalPolicy Json    @default("{}")
  deals         Deal[]
  opportunities Opportunity[]
  brandInterest BrandInterest[]

  /// Whether this creator appears on the roster brands browse.
  ///
  /// Defaults to FALSE and stays false until the creator says otherwise. Every
  /// creator who existed before this column was added is therefore unlisted,
  /// which is the correct answer: they were never asked. An opt-out default
  /// would have silently published them.
  listedOnRoster Boolean @default(false)

  // --- Creator sign-in ---
  // The creator's own login, separate from the operator password. `email` above
  // is the identity, so there is no second copy of it to drift.
  //
  // Null passwordHash means "invited but not activated" (or never invited) —
  // that account cannot sign in. The invite token is single-use: consumed and
  // nulled the moment a password is set, so a forwarded link is inert.
  passwordHash         String?
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  lastLoginAt          DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SocialAccount {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id])
  platform      Platform
  handle        String
  followerCount Int?
  // Shape defined by AudienceMetricsSchema in lib/creators/metrics.ts. Carries
  // its own `source` so a hand-entered figure never looks like a synced one.
  metrics       Json     @default("{}")
  lastSyncedAt  DateTime?

  // Platform OAuth connection. Null until the creator connects the account.
  // externalId is TikTok's open_id — stable per app, and how we re-find them.
  externalId     String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[] @default([])

  @@unique([platform, handle])
  @@index([creatorId])
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  SNAPCHAT
  TWITCH
  OTHER
}

model Brand {
  id            String   @id @default(cuid())
  name          String   @unique
  website       String?
  category      String?
  // Evidence of creator-sponsorship activity (which creators, platforms, formats)
  sponsorSignals Json    @default("{}")
  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]
  // Per-brand relationship memory: tone, history, preferences
  relationshipNotes Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      BrandAccount[]
  /// One line on what the company IS — not why they fit. Shown on the card
  /// before anything is expanded, so a creator can skim a shortlist without
  /// reading four paragraphs.
  summary       String?
}

model Contact {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id])
  name      String?
  email     String?
  role      String?
  source    String? // where Scout found them
  createdAt DateTime @default(now())

  @@unique([brandId, email])
}

// A scored lead produced by Scout, before any outreach
model Opportunity {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  fitScore    Float    // 0–1, Scout's fit vs. niche/audience/rates/guardrails
  rationale   String   // why Scout thinks this is a fit
  // The checkable claim behind the fit — a sponsorship they've run, an
  // ambassador programme. Kept separate from rationale so a human can verify
  // the fact without re-reading the argument.
  evidence        String?
  suggestedFormat String?
  status      OpportunityStatus @default(SOURCED)
  deal        Deal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([creatorId, brandId])
  // --- Outreach draft ---
  // The actual email the creator reads and approves. Drafted on demand by the
  // Pitch agent, not for every brand Scout finds. draftApprovedAt is what makes
  // "approve outreach" mean approving WORDS rather than a status change.
  draftSubject     String?
  draftBody        String?  @db.Text
  draftGeneratedAt DateTime?
  draftApprovedAt  DateTime?
}

enum OpportunityStatus {
  SOURCED
  QUALIFIED   // human-approved for outreach
  REJECTED    // creator said no
  CONVERTED   // became a Deal
}

// Deal state machine — blueprint §4. Transitions ONLY via lib/deals/stateMachine.ts
model Deal {
  id            String    @id @default(cuid())
  creatorId     String
  creator       Creator   @relation(fields: [creatorId], references: [id])
  brandId       String
  brand         Brand     @relation(fields: [brandId], references: [id])
  opportunityId String?   @unique
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  state         DealState @default(PITCHED)
  // Live negotiated terms: rate, deliverables, usage rights, exclusivity,
  // payment schedule, kill fee, disclosure requirements
  terms         Json      @default("{}")

  // --- Creator approval of the terms ---
  // A creator must approve the material terms before a contract can be sent.
  // The fingerprint is a hash of those terms AS APPROVED, so editing the money
  // after the fact silently invalidates the approval rather than carrying it
  // forward. See termsFingerprint() in lib/deals/terms.ts.
  termsApprovedAt          DateTime?
  termsApprovedFingerprint String?
  // Set when the creator asks for changes instead of approving.
  creatorTermsNote         String?

  transitions   DealTransition[]
  interactions  Interaction[]
  contracts     Contract[]
  deliverables  Deliverable[]
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum DealState {
  PITCHED
  NEGOTIATING
  TERMS_AGREED
  CONTRACT_SENT
  SIGNED
  IN_PRODUCTION
  DELIVERED
  INVOICED
  PAID
  RENEWAL_WATCH
  LOST
}

// Append-only log of every state change — the terms-advisor training data
model DealTransition {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  fromState DealState
  toState   DealState
  actor     String    // agent name or "human:<userId>"
  // Snapshot of terms at transition time (anonymizable for benchmarks)
  termsSnapshot Json  @default("{}")
  note      String?
  createdAt DateTime  @default(now())
}

// Every agent/human touch on a deal: emails sent/received, approvals, escalations
model Interaction {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  channel   String   // email | dashboard | system
  direction String   // outbound | inbound | internal
  actor     String   // pitch | negotiator | counsel | books | human:<id> | brand
  subject   String?
  body      String?
  // For outbound agent messages: was this gated, and who approved
  approval  Json     @default("{}")
  createdAt DateTime @default(now())
}

model Contract {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  version    Int      @default(1)
  templateId String?
  // Structured terms the doc was generated from
  terms      Json     @default("{}")
  fileUrl    String?
  status     ContractStatus @default(DRAFT)
  // Counsel's redline flags on inbound contracts (perpetual usage, broad exclusivity…)
  riskFlags  Json     @default("[]")
  sentAt     DateTime?
  signedAt   DateTime?
  createdAt  DateTime @default(now())
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

model Deliverable {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  platform    Platform
  format      String   // dedicated video, integration, story set, post…
  dueAt       DateTime?
  postedUrl   String?
  // FTC disclosure checklist state
  disclosure  Json     @default("{}")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Invoice {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  amountCents Int
  currency   String   @default("USD")
  status     InvoiceStatus @default(DRAFT)
  // CardPointe refs (gateway txn ids, ACH refs) — MVP tracks, never holds funds
  paymentRefs Json    @default("{}")
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
  VOID
}

// Anonymized closed-deal terms — the P4 moat. Written on PAID transition.
model TermsBenchmark {
  id            String   @id @default(cuid())
  niche         String
  platform      Platform
  followerBand  String   // e.g. "500K-1M"
  format        String
  usageRights   String?
  exclusivity   String?
  amountCents   Int
  currency      String   @default("USD")
  source        String   @default("internal") // internal | external
  closedAt      DateTime
  createdAt     DateTime @default(now())
}

/// A brand's LOGIN, deliberately separate from the Brand record.
///
/// Brand rows are created by Scout — 40-odd companies it has researched, most
/// of which have never heard of Nspiire. Conflating "a company we know about"
/// with "a paying customer who can sign in" would mean Scout inventing accounts,
/// and a name collision would hand someone else's profile to whoever signed up
/// first. A BrandAccount may CLAIM a Brand, and until an operator says so it
/// claims nothing.
model BrandAccount {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  contactName  String
  companyName  String
  website      String?

  /// Set only when an operator matches this account to a researched Brand.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  /// What they are actually looking for. This is the point of the interest
  /// list while the roster is small: it says which creators to go and recruit,
  /// which is a much stronger position than recruiting and hoping demand turns
  /// up. Free text on purpose — a dropdown would decide the taxonomy before
  /// there is enough data to know it.
  lookingFor  String?
  budgetRange String?
  timing      String?

  /// Dormant. Everyone joins an interest list today and nobody is charged;
  /// switching membership on later is a copy change plus Stripe, not a rebuild.
  membership   MembershipStatus @default(PENDING)
  appliedAt    DateTime         @default(now())
  decidedAt    DateTime?
  decidedBy    String?
  /// Why an application was declined — shown to the applicant.
  decisionNote String?

  lastLoginAt DateTime?
  interests   BrandInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membership])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DECLINED
  CANCELLED
}

/// A brand saying "we like this creator". Non-mutual until the creator accepts:
/// no thread, no contact details, no message. The creator's consent is the only
/// thing that opens a channel, exactly as it is for outreach the other way.
model BrandInterest {
  id             String       @id @default(cuid())
  brandAccountId String
  brandAccount   BrandAccount @relation(fields: [brandAccountId], references: [id])
  creatorId      String
  creator        Creator      @relation(fields: [creatorId], references: [id])

  /// What the brand is thinking — the creator sees this when deciding.
  note String?

  status     InterestStatus @default(SENT)
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@unique([brandAccountId, creatorId])
  @@index([creatorId, status])
}

enum InterestStatus {
  SENT
  ACCEPTED
  DECLINED
}
