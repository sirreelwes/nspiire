// Nspiire core data model — blueprint §6
// Every state transition and interaction is logged: that log is the
// training data for the deal-terms advisor (blueprint P4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  niche         String?
  // Linked social accounts
  socials       SocialAccount[]
  // Negotiation guardrails: floor rates, deliverable limits, usage-rights
  // limits, exclusivity limits, do-not-work-with list. JSON for MVP.
  guardrails    Json     @default("{}")
  // Rate card per deliverable type
  rateCard      Json     @default("{}")
  // Voice/style samples for Pitch agent
  voiceProfile  Json     @default("{}")
  // Approval policy: which gates require human sign-off (default: all)
  approvalPolicy Json    @default("{}")
  // Whether they take physical product at all, whether a brand must ask first,
  // and how far a deal must get before their address is handed over. Shape
  // defined by GiftingPolicySchema in lib/creators/shipping.ts.
  giftingPolicy Json     @default("{}")
  // Default virtual agent for this account. A deal can override it.
  personaId     String?
  persona       Persona? @relation(fields: [personaId], references: [id])
  // Where product may be sent. A relation, not a Json column, so it is never
  // swept up by a `include: { socials: true }`-style read of the creator.
  shippingDestinations ShippingDestination[]
  deals         Deal[]
  opportunities Opportunity[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SocialAccount {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id])
  platform      Platform
  handle        String
  followerCount Int?
  // Shape defined by AudienceMetricsSchema in lib/creators/metrics.ts. Carries
  // its own `source` so a hand-entered figure never looks like a synced one.
  metrics       Json     @default("{}")
  lastSyncedAt  DateTime?

  // Platform OAuth connection. Null until the creator connects the account.
  // externalId is TikTok's open_id — stable per app, and how we re-find them.
  externalId     String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[] @default([])

  @@unique([platform, handle])
  @@index([creatorId])
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  SNAPCHAT
  TWITCH
  OTHER
}

// Where a brand may send product. The most sensitive data in the system: for
// most creators this is a home address, and the one thing they cannot take back
// once it is out. Three rules hold it in:
//   1. It is NEVER put in a model prompt. No agent needs it to do its job, and
//      a prompt is the one place data goes somewhere we don't control.
//   2. It is released to a brand only once the deal reaches the state the
//      creator chose (GiftingPolicy.releaseAddressAt) — see addressReleased().
//   3. Rows are archived, never deleted, because a parcel already in flight was
//      addressed to one of them and the record of where it went has to survive.
model ShippingDestination {
  id           String    @id @default(cuid())
  creatorId    String
  creator      Creator   @relation(fields: [creatorId], references: [id])
  // What the creator calls it — "Studio", "PO box", "Manager's office".
  label        String
  // Who the parcel is addressed to. Deliberately separate from Creator.name:
  // plenty of creators do not want their legal name on a courier label.
  recipient    String
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String
  country      String    @default("US")
  // For the courier: buzzer codes, front-desk instructions, delivery windows.
  instructions String?
  isDefault    Boolean   @default(false)
  archivedAt   DateTime?
  deals        Deal[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([creatorId])
}

// A virtual agent — the person a brand thinks they are emailing, and the one
// the creator talks to about a deal.
//
// A Persona is NOT an agent in the lib/agents sense. Those are capabilities:
// Scout scores, Negotiator counters, Books invoices. A Persona is a voice
// wearing them. Iris runs outreach and brings deals back; the next one may be
// warmer, or blunter, or work a different vertical. That is why voice lives in
// a row a creator can assign rather than in a const in a prompt file.
//
// She never pretends to be human. See DISCLOSURE in lib/agents/persona.ts:
// that clause is appended to every persona's system prompt and cannot be
// configured off.
model Persona {
  id        String   @id @default(cuid())
  name      String   @unique
  // What she signs off as — "Partnerships, Nspiire".
  title     String
  // Tone, traits, things she never says. Shape: PersonaVoiceSchema.
  voice     Json     @default("{}")
  // One line about who she is, shown to the creator when assigning her.
  bio       String?
  isActive  Boolean  @default(true)
  creators  Creator[]
  deals     Deal[]
  interactions Interaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id            String   @id @default(cuid())
  name          String   @unique
  website       String?
  category      String?
  // Evidence of creator-sponsorship activity (which creators, platforms, formats)
  sponsorSignals Json    @default("{}")
  contacts      Contact[]
  opportunities Opportunity[]
  deals         Deal[]
  // Per-brand relationship memory: tone, history, preferences
  relationshipNotes Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contact {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id])
  name      String?
  email     String?
  role      String?
  source    String? // where Scout found them
  createdAt DateTime @default(now())

  @@unique([brandId, email])
}

// A scored lead produced by Scout, before any outreach
model Opportunity {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  fitScore    Float    // 0–1, Scout's fit vs. niche/audience/rates/guardrails
  rationale   String   // why Scout thinks this is a fit
  // The checkable claim behind the fit — a sponsorship they've run, an
  // ambassador programme. Kept separate from rationale so a human can verify
  // the fact without re-reading the argument.
  evidence        String?
  suggestedFormat String?
  status      OpportunityStatus @default(SOURCED)
  deal        Deal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([creatorId, brandId])
}

enum OpportunityStatus {
  SOURCED
  QUALIFIED   // human-approved for outreach
  REJECTED    // creator said no
  CONVERTED   // became a Deal
}

// Deal state machine — blueprint §4. Transitions ONLY via lib/deals/stateMachine.ts
model Deal {
  id            String    @id @default(cuid())
  creatorId     String
  creator       Creator   @relation(fields: [creatorId], references: [id])
  brandId       String
  brand         Brand     @relation(fields: [brandId], references: [id])
  opportunityId String?   @unique
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  state         DealState @default(PITCHED)
  // Live negotiated terms: rate, deliverables, usage rights, exclusivity,
  // payment schedule, kill fee, disclosure requirements
  terms         Json      @default("{}")
  // Where product for THIS deal goes. Null falls back to the creator's default
  // destination; an explicit value is the creator sending one deal elsewhere.
  // Kept off Deal.terms on purpose — this is logistics, not a negotiated term,
  // and terms are snapshotted into the append-only transition log.
  shipToId      String?
  shipTo        ShippingDestination? @relation(fields: [shipToId], references: [id])
  // Who runs this deal. Null falls back to the creator's default persona.
  personaId     String?
  persona       Persona? @relation(fields: [personaId], references: [id])
  transitions   DealTransition[]
  interactions  Interaction[]
  contracts     Contract[]
  deliverables  Deliverable[]
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum DealState {
  PITCHED
  NEGOTIATING
  TERMS_AGREED
  CONTRACT_SENT
  SIGNED
  IN_PRODUCTION
  DELIVERED
  INVOICED
  PAID
  RENEWAL_WATCH
  LOST
}

// Append-only log of every state change — the terms-advisor training data
model DealTransition {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  fromState DealState
  toState   DealState
  actor     String    // agent name or "human:<userId>"
  // Snapshot of terms at transition time (anonymizable for benchmarks)
  termsSnapshot Json  @default("{}")
  note      String?
  createdAt DateTime  @default(now())
}

// Every agent/human touch on a deal: emails sent/received, approvals, escalations
model Interaction {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  channel   String   // email | dashboard | system
  direction String   // outbound | inbound | internal
  actor     String   // pitch | negotiator | counsel | books | human:<id> | brand
  // Set when a persona spoke or was spoken to, so "everything Iris said on
  // this deal" is a query rather than a string match on `actor`.
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id])
  // Who the message was for. A brand thread and the creator's own thread live
  // in the same table and must never be shown to each other.
  audience  String   @default("creator") // creator | brand
  subject   String?
  body      String?
  // For outbound agent messages: was this gated, and who approved
  approval  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([dealId, audience, createdAt])
}

model Contract {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  version    Int      @default(1)
  templateId String?
  // Structured terms the doc was generated from
  terms      Json     @default("{}")
  fileUrl    String?
  status     ContractStatus @default(DRAFT)
  // Counsel's redline flags on inbound contracts (perpetual usage, broad exclusivity…)
  riskFlags  Json     @default("[]")
  sentAt     DateTime?
  signedAt   DateTime?
  createdAt  DateTime @default(now())
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

model Deliverable {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  platform    Platform
  format      String   // dedicated video, integration, story set, post…
  dueAt       DateTime?
  postedUrl   String?
  // FTC disclosure checklist state
  disclosure  Json     @default("{}")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Invoice {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  // A closed deal raises two invoices, both to the brand: the creator's rate
  // and Nspiire's deal fee (lib/deals/fee.ts). They are separate rows, not one
  // row Nspiire collects and splits — MVP never holds funds, so the fee is
  // billed on its own and the creator's money never passes through us.
  kind       InvoiceKind   @default(CREATOR_RATE)
  amountCents Int
  currency   String   @default("USD")
  status     InvoiceStatus @default(DRAFT)
  // CardPointe refs (gateway txn ids, ACH refs) — MVP tracks, never holds funds
  paymentRefs Json    @default("{}")
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
}

// Who the money on this invoice is for. The brand pays both.
enum InvoiceKind {
  CREATOR_RATE // the negotiated rate, owed to the creator
  PLATFORM_FEE // Nspiire's deal fee, charged on top and owed to Nspiire
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
  VOID
}

// Anonymized closed-deal terms — the P4 moat. Written on PAID transition.
model TermsBenchmark {
  id            String   @id @default(cuid())
  niche         String
  platform      Platform
  followerBand  String   // e.g. "500K-1M"
  format        String
  usageRights   String?
  exclusivity   String?
  amountCents   Int
  currency      String   @default("USD")
  source        String   @default("internal") // internal | external
  closedAt      DateTime
  createdAt     DateTime @default(now())
}
